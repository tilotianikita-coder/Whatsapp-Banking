system:
    instructions: "You are LoanSeva by Kotak, the WhatsApp personal loan assistant of Kotak Mahindra Bank. You help existing Kotak personal loan customers explore a Personal Loan Top-Up: answer questions, verify them, personalise an offer and book a specialist callback. Tone: warm, aspirational and concise. Guardrails: never reveal full account numbers (only the masked form returned by actions); never promise final approval (offers are preliminary and subject to verification); stay on Kotak lending topics; offer a human specialist whenever the customer asks for one or seems confused twice in a row. Do not write your own customer replies when an action applies: call the action and relay its message exactly. The conversation language is {!@variables.language} (EN English, HI Hindi, MR Marathi); any short text you write yourself must be in that language."
    messages:
        welcome: "Hi! 👋 I'm LoanSeva by Kotak. Reply Continue Here! to see your Personal Loan Top-Up offer."
        error: "Sorry, I hit a small snag on my side. 🙏 Reply Agent to connect with a Kotak specialist."

config:
    developer_name: "LoanSeva_by_Kotak"
    default_agent_user: "loanseva.agent.00dgl00000eqlv3@example.com"
    agent_label: "LoanSeva by Kotak"
    description: "WhatsApp assistant for the Kotak Personal Loan Top-Up journey: grounded FAQ, OTP verification, personalisation, offer, callback booking and feedback, in English, Hindi and Marathi."

variables:
    EndUserId: linked string
        source: @MessagingSession.MessagingEndUserId
        description: "This variable may also be referred to as MessagingEndUser Id"
    RoutableId: linked string
        source: @MessagingSession.Id
        description: "This variable may also be referred to as MessagingSession Id"
    ContactId: linked string
        source: @MessagingEndUser.ContactId
        description: "This variable may also be referred to as MessagingEndUser ContactId"
    EndUserLanguage: linked string
        source: @MessagingSession.EndUserLanguage
        description: "This variable may also be referred to as MessagingSession EndUserLanguage"
    journey_id: mutable string = ""
        description: "LoanSeva loan journey id returned by the last action"
    awaiting: mutable string = "menu"
        description: "What the journey needs next, returned by the last action"
    language: mutable string = "EN"
        description: "Conversation language: EN, HI or MR"

language:
    default_locale: "en_US"
    additional_locales: ""
    all_additional_locales: False

start_agent agent_router:
    label: "Agent Router"
    description: "Routes each customer message to the right LoanSeva subagent based on the journey state"

    reasoning:
        instructions: ->
            | Route every customer message to exactly one subagent using the journey state. Never answer the customer yourself here.
              Journey state: awaiting = {!@variables.awaiting}
              1. The customer asks to change language (EN, HI, MR, English, Hindi, Marathi, हिंदी, मराठी) -> go_to_language_switch.
              2. The customer asks for a human, agent, specialist, RM or a call right now -> go_to_escalation.
              3. awaiting is identity, otp or loan_confirm -> go_to_verify.
              4. awaiting is employment, company, income, purpose or amount -> go_to_personalise.
              5. awaiting is offer_decision or callback -> go_to_offer_callback.
              6. awaiting is feedback_csat, feedback_resolution or feedback_comment -> go_to_feedback.
              7. Everything else, including greetings, Continue Here!, questions about Top-Up, menu, done or handoff -> go_to_top_up_faq.
              8. Only clearly unrelated requests (not about loans, Kotak or banking) -> go_to_off_topic.
        actions:
            go_to_top_up_faq: @utils.transition to @subagent.top_up_faq
            go_to_verify: @utils.transition to @subagent.verify
            go_to_personalise: @utils.transition to @subagent.personalise
            go_to_offer_callback: @utils.transition to @subagent.offer_callback
            go_to_feedback: @utils.transition to @subagent.feedback
            go_to_language_switch: @utils.transition to @subagent.language_switch
            go_to_escalation: @utils.transition to @subagent.escalation
            go_to_off_topic: @utils.transition to @subagent.off_topic

subagent top_up_faq:
    label: "Top-Up FAQ"
    description: "Welcome menu and grounded answers to questions about Kotak Personal Loan Top-Up (uses, rates, how it differs from a new loan, disbursal speed, fees, documents, tenure, eligibility)."

    reasoning:
        instructions: ->
            | You handle the welcome, the main menu and questions about Kotak Personal Loan Top-Up.
              If the customer asks to change language, use go_to_language_switch. If they ask for a human, agent, specialist or RM, use go_to_escalation.
              If awaiting ({!@variables.awaiting}) belongs to another subagent, transition there first: identity, otp or loan_confirm -> go_to_verify; employment, company, income, purpose or amount -> go_to_personalise; offer_decision or callback -> go_to_offer_callback; feedback_csat, feedback_resolution or feedback_comment -> go_to_feedback.
              - First message, greeting, Continue Here!, Continue, Hi or Start (or journey_id is empty) -> call start_journey.
              - A question about Top-Up (uses, rate, difference from a new loan, speed, fees, documents, tenure, eligibility, or similar) -> call answer_question with the question as typed.
              - Menu option 1, Yes, see my offer, verify, or any wish to proceed -> call verify_customer with empty inputs (it asks for name and mobile), unless the customer already gave both, then pass them.
              - Menu option 2 without a question -> ask briefly, in the conversation language, what they would like to know about Top-Up.
              - Menu option 3 -> go_to_escalation.
              - awaiting is done: answer questions with answer_question; for thanks or goodbyes reply with one short warm line in the conversation language.
              Every LoanSeva action returns an output called message. Your reply to the customer MUST be exactly that message text,
              character for character: keep every emoji, *asterisk*, line break and number. Do not add greetings, summaries,
              explanations or translations before or after it, and never reply with only an acknowledgement.
        actions:
            start_journey: @actions.start_journey
                with journeyId = @variables.journey_id
                with sessionId = @variables.RoutableId
                set @variables.journey_id = @outputs.journeyId
                set @variables.awaiting = @outputs.awaiting
                set @variables.language = @outputs.language
            answer_question: @actions.answer_question
                with journeyId = @variables.journey_id
                with sessionId = @variables.RoutableId
                with question = ...
                set @variables.journey_id = @outputs.journeyId
                set @variables.awaiting = @outputs.awaiting
                set @variables.language = @outputs.language
            verify_customer: @actions.verify_customer
                with journeyId = @variables.journey_id
                with sessionId = @variables.RoutableId
                with customerName = ...
                with registeredMobile = ...
                set @variables.journey_id = @outputs.journeyId
                set @variables.awaiting = @outputs.awaiting
                set @variables.language = @outputs.language
            go_to_verify: @utils.transition to @subagent.verify
            go_to_personalise: @utils.transition to @subagent.personalise
            go_to_offer_callback: @utils.transition to @subagent.offer_callback
            go_to_feedback: @utils.transition to @subagent.feedback
            go_to_language_switch: @utils.transition to @subagent.language_switch
            go_to_escalation: @utils.transition to @subagent.escalation

    actions:
        start_journey:
            description: "Starts or resumes the Kotak Personal Loan Top-Up journey and returns the personalised welcome menu."
            label: "Start Journey"
            target: "apex://LoanSevaStartAction"
            include_in_progress_indicator: False
            inputs:
                journeyId: string
                    label: "Journey Id"
                    description: "Loan journey id from the previous action."
                    is_required: False
                sessionId: string
                    label: "Messaging Session Id"
                    description: "Current messaging session id."
                    is_required: False
            outputs:
                message: string
                    label: "Message"
                    description: "Reply to send to the customer exactly as written, already localised and formatted for WhatsApp."
                    is_displayable: False
                    filter_from_agent: False
                journeyId: string
                    label: "Journey Id"
                    description: "Loan journey record id."
                    is_displayable: False
                    filter_from_agent: False
                awaiting: string
                    label: "Awaiting"
                    description: "What the journey needs next."
                    is_displayable: False
                    filter_from_agent: False
                language: string
                    label: "Language"
                    description: "Conversation language: EN, HI or MR."
                    is_displayable: False
                    filter_from_agent: False
                stage: string
                    label: "Stage"
                    description: "Journey stage."
                    is_displayable: False
                    filter_from_agent: False
                handoff: boolean
                    label: "Handoff Recommended"
                    description: "True when a human specialist should take over."
                    is_displayable: False
                    filter_from_agent: False
                success: boolean
                    label: "Success"
                    description: "False when the input could not be used and the customer is being re-asked."
                    is_displayable: False
                    filter_from_agent: False
        answer_question:
            description: "Answers a question about Kotak Personal Loan Top-Up (uses, interest rate, how it differs from a new loan, disbursal speed, fees, documents, tenure, eligibility) from approved content, then re-asks whatever the journey is waiting for."
            label: "Answer Top-Up Question"
            target: "apex://LoanSevaFaqAction"
            include_in_progress_indicator: False
            inputs:
                journeyId: string
                    label: "Journey Id"
                    description: "Loan journey id from the previous action."
                    is_required: False
                sessionId: string
                    label: "Messaging Session Id"
                    description: "Current messaging session id."
                    is_required: False
                question: string
                    label: "Question"
                    description: "The question exactly as the customer typed it."
                    is_required: True
            outputs:
                message: string
                    label: "Message"
                    description: "Reply to send to the customer exactly as written, already localised and formatted for WhatsApp."
                    is_displayable: False
                    filter_from_agent: False
                journeyId: string
                    label: "Journey Id"
                    description: "Loan journey record id."
                    is_displayable: False
                    filter_from_agent: False
                awaiting: string
                    label: "Awaiting"
                    description: "What the journey needs next."
                    is_displayable: False
                    filter_from_agent: False
                language: string
                    label: "Language"
                    description: "Conversation language: EN, HI or MR."
                    is_displayable: False
                    filter_from_agent: False
                stage: string
                    label: "Stage"
                    description: "Journey stage."
                    is_displayable: False
                    filter_from_agent: False
                handoff: boolean
                    label: "Handoff Recommended"
                    description: "True when a human specialist should take over."
                    is_displayable: False
                    filter_from_agent: False
                success: boolean
                    label: "Success"
                    description: "False when the input could not be used and the customer is being re-asked."
                    is_displayable: False
                    filter_from_agent: False
        verify_customer:
            description: "Checks the customer full name and registered mobile against Kotak records and sends the OTP. Call with empty inputs to ask the customer for them."
            label: "Verify Customer"
            target: "apex://LoanSevaVerifyAction"
            include_in_progress_indicator: False
            inputs:
                journeyId: string
                    label: "Journey Id"
                    description: "Loan journey id from the previous action."
                    is_required: False
                sessionId: string
                    label: "Messaging Session Id"
                    description: "Current messaging session id."
                    is_required: False
                customerName: string
                    label: "Customer Name"
                    description: "Full name as given by the customer. Empty if not given yet."
                    is_required: False
                registeredMobile: string
                    label: "Registered Mobile"
                    description: "10-digit registered mobile as given by the customer. Empty if not given yet."
                    is_required: False
            outputs:
                message: string
                    label: "Message"
                    description: "Reply to send to the customer exactly as written, already localised and formatted for WhatsApp."
                    is_displayable: False
                    filter_from_agent: False
                journeyId: string
                    label: "Journey Id"
                    description: "Loan journey record id."
                    is_displayable: False
                    filter_from_agent: False
                awaiting: string
                    label: "Awaiting"
                    description: "What the journey needs next."
                    is_displayable: False
                    filter_from_agent: False
                language: string
                    label: "Language"
                    description: "Conversation language: EN, HI or MR."
                    is_displayable: False
                    filter_from_agent: False
                stage: string
                    label: "Stage"
                    description: "Journey stage."
                    is_displayable: False
                    filter_from_agent: False
                handoff: boolean
                    label: "Handoff Recommended"
                    description: "True when a human specialist should take over."
                    is_displayable: False
                    filter_from_agent: False
                success: boolean
                    label: "Success"
                    description: "False when the input could not be used and the customer is being re-asked."
                    is_displayable: False
                    filter_from_agent: False

subagent verify:
    label: "Verify"
    description: "Verifies the customer with name, registered mobile and OTP, shows the existing loan snapshot and gets confirmation."

    reasoning:
        instructions: ->
            | You verify the customer. awaiting = {!@variables.awaiting}.
              If the customer asks to change language, use go_to_language_switch. If they ask for a human, agent, specialist or RM, use go_to_escalation.
              If awaiting ({!@variables.awaiting}) belongs to another subagent, transition there first: menu, done or handoff -> go_to_top_up_faq; employment, company, income, purpose or amount -> go_to_personalise; offer_decision or callback -> go_to_offer_callback; feedback_csat, feedback_resolution or feedback_comment -> go_to_feedback.
              - awaiting identity: extract the full name and the 10-digit mobile from the message and call verify_customer. If only one is given, pass what you have.
              - awaiting otp: call verify_otp with the code exactly as typed. Never reveal or repeat the OTP yourself.
              - awaiting loan_confirm: yes / correct / haan / हाँ / हो / 1 -> confirm_loan with confirmed True; no / wrong / नहीं / नाही / 2 -> confirmed False.
              - A question about Top-Up at any point -> answer_question.
              Every LoanSeva action returns an output called message. Your reply to the customer MUST be exactly that message text,
              character for character: keep every emoji, *asterisk*, line break and number. Do not add greetings, summaries,
              explanations or translations before or after it, and never reply with only an acknowledgement.
        actions:
            verify_customer: @actions.verify_customer
                available when @variables.awaiting == "identity"
                with journeyId = @variables.journey_id
                with sessionId = @variables.RoutableId
                with customerName = ...
                with registeredMobile = ...
                set @variables.journey_id = @outputs.journeyId
                set @variables.awaiting = @outputs.awaiting
                set @variables.language = @outputs.language
            verify_otp: @actions.verify_otp
                available when @variables.awaiting == "otp"
                with journeyId = @variables.journey_id
                with sessionId = @variables.RoutableId
                with otp = ...
                set @variables.journey_id = @outputs.journeyId
                set @variables.awaiting = @outputs.awaiting
                set @variables.language = @outputs.language
            confirm_loan: @actions.confirm_loan
                available when @variables.awaiting == "loan_confirm"
                with journeyId = @variables.journey_id
                with sessionId = @variables.RoutableId
                with confirmed = ...
                set @variables.journey_id = @outputs.journeyId
                set @variables.awaiting = @outputs.awaiting
                set @variables.language = @outputs.language
            answer_question: @actions.answer_question
                with journeyId = @variables.journey_id
                with sessionId = @variables.RoutableId
                with question = ...
                set @variables.journey_id = @outputs.journeyId
                set @variables.awaiting = @outputs.awaiting
                set @variables.language = @outputs.language
            go_to_top_up_faq: @utils.transition to @subagent.top_up_faq
            go_to_personalise: @utils.transition to @subagent.personalise
            go_to_offer_callback: @utils.transition to @subagent.offer_callback
            go_to_feedback: @utils.transition to @subagent.feedback
            go_to_language_switch: @utils.transition to @subagent.language_switch
            go_to_escalation: @utils.transition to @subagent.escalation

    actions:
        verify_customer:
            description: "Checks the customer full name and registered mobile against Kotak records and sends the OTP. Call with empty inputs to ask the customer for them."
            label: "Verify Customer"
            target: "apex://LoanSevaVerifyAction"
            include_in_progress_indicator: False
            inputs:
                journeyId: string
                    label: "Journey Id"
                    description: "Loan journey id from the previous action."
                    is_required: False
                sessionId: string
                    label: "Messaging Session Id"
                    description: "Current messaging session id."
                    is_required: False
                customerName: string
                    label: "Customer Name"
                    description: "Full name as given by the customer. Empty if not given yet."
                    is_required: False
                registeredMobile: string
                    label: "Registered Mobile"
                    description: "10-digit registered mobile as given by the customer. Empty if not given yet."
                    is_required: False
            outputs:
                message: string
                    label: "Message"
                    description: "Reply to send to the customer exactly as written, already localised and formatted for WhatsApp."
                    is_displayable: False
                    filter_from_agent: False
                journeyId: string
                    label: "Journey Id"
                    description: "Loan journey record id."
                    is_displayable: False
                    filter_from_agent: False
                awaiting: string
                    label: "Awaiting"
                    description: "What the journey needs next."
                    is_displayable: False
                    filter_from_agent: False
                language: string
                    label: "Language"
                    description: "Conversation language: EN, HI or MR."
                    is_displayable: False
                    filter_from_agent: False
                stage: string
                    label: "Stage"
                    description: "Journey stage."
                    is_displayable: False
                    filter_from_agent: False
                handoff: boolean
                    label: "Handoff Recommended"
                    description: "True when a human specialist should take over."
                    is_displayable: False
                    filter_from_agent: False
                success: boolean
                    label: "Success"
                    description: "False when the input could not be used and the customer is being re-asked."
                    is_displayable: False
                    filter_from_agent: False
        verify_otp:
            description: "Checks the OTP typed by the customer and returns the existing loan snapshot on success."
            label: "Verify OTP"
            target: "apex://LoanSevaOtpAction"
            include_in_progress_indicator: False
            inputs:
                journeyId: string
                    label: "Journey Id"
