subagent offer_callback:
    label: "Offer and Callback"
    description: "Presents and edits the preliminary Top-Up offer, accepts it with a reference number and books the specialist callback."

    reasoning:
        instructions: ->
            | You present the offer and book the callback. awaiting = {!@variables.awaiting}.
              If the customer asks to change language, use go_to_language_switch. If they ask for a human, agent, specialist or RM, use go_to_escalation.
              If awaiting ({!@variables.awaiting}) belongs to another subagent, transition there first: menu, done or handoff -> go_to_top_up_faq; identity, otp or loan_confirm -> go_to_verify; employment, company, income, purpose or amount -> go_to_personalise; feedback_csat, feedback_resolution or feedback_comment -> go_to_feedback.
              - awaiting offer_decision: 1 / accept / yes / go ahead -> accept_offer. A new amount or tenure (e.g. 3 lakh, 48 months, 4 years) -> get_offer with it.
                2 / change without details -> ask briefly, in the conversation language, for the new amount (e.g. 3 lakh) and/or tenure (e.g. 48 months).
                3 or a question -> answer_question (for a bare 3, ask what they would like to know).
              - awaiting callback: call schedule_callback with the reply exactly as typed (option number or day and time).
              Every LoanSeva action returns an output called message. Your reply to the customer MUST be exactly that message text,
              character for character: keep every emoji, *asterisk*, line break and number. Do not add greetings, summaries,
              explanations or translations before or after it, and never reply with only an acknowledgement.
        actions:
            accept_offer: @actions.accept_offer
                available when @variables.awaiting == "offer_decision"
                with journeyId = @variables.journey_id
                with sessionId = @variables.RoutableId
                set @variables.journey_id = @outputs.journeyId
                set @variables.awaiting = @outputs.awaiting
                set @variables.language = @outputs.language
            get_offer: @actions.get_offer
                available when @variables.awaiting == "offer_decision"
                with journeyId = @variables.journey_id
                with sessionId = @variables.RoutableId
                with amount = ...
                with tenure = ...
                set @variables.journey_id = @outputs.journeyId
                set @variables.awaiting = @outputs.awaiting
                set @variables.language = @outputs.language
            schedule_callback: @actions.schedule_callback
                available when @variables.awaiting == "callback"
                with journeyId = @variables.journey_id
                with sessionId = @variables.RoutableId
                with preference = ...
                set @variables.journey_id = @outputs.journeyId
                set @variables.awaiting = @outputs.awaiting
                set @variables.language = @outputs.language
            answer_question: @actions.answer_question
                with journeyId = @variables.journey_id
                with sessionId = @variables.RoutableId
                with question = ...
                set @variables.journey_id = @outputs.journeyId
                set @variables.awaiting = @outputs.awaiting
                set @variables.language = @outputs.language
            go_to_top_up_faq: @utils.transition to @subagent.top_up_faq
            go_to_verify: @utils.transition to @subagent.verify
            go_to_personalise: @utils.transition to @subagent.personalise
            go_to_feedback: @utils.transition to @subagent.feedback
            go_to_language_switch: @utils.transition to @subagent.language_switch
            go_to_escalation: @utils.transition to @subagent.escalation

    actions:
        accept_offer:
            description: "Accepts the current offer, generates the reference number and returns the callback slot options."
            label: "Accept Offer"
            target: "apex://LoanSevaAcceptOfferAction"
            include_in_progress_indicator: False
            inputs:
                journeyId: string
                    label: "Journey Id"
                    description: "Loan journey id from the previous action."
                    is_required: False
                sessionId: string
                    label: "Messaging Session Id"
                    description: "Current messaging session id."
                    is_required: False
            outputs:
                message: string
                    label: "Message"
                    description: "Reply to send to the customer exactly as written, already localised and formatted for WhatsApp."
                    is_displayable: False
                    filter_from_agent: False
                journeyId: string
                    label: "Journey Id"
                    description: "Loan journey record id."
                    is_displayable: False
                    filter_from_agent: False
                awaiting: string
                    label: "Awaiting"
                    description: "What the journey needs next."
                    is_displayable: False
                    filter_from_agent: False
                language: string
                    label: "Language"
                    description: "Conversation language: EN, HI or MR."
                    is_displayable: False
                    filter_from_agent: False
                stage: string
                    label: "Stage"
                    description: "Journey stage."
                    is_displayable: False
                    filter_from_agent: False
                handoff: boolean
                    label: "Handoff Recommended"
                    description: "True when a human specialist should take over."
                    is_displayable: False
                    filter_from_agent: False
                success: boolean
                    label: "Success"
                    description: "False when the input could not be used and the customer is being re-asked."
                    is_displayable: False
                    filter_from_agent: False
        get_offer:
            description: "Recalculates the personalised preliminary offer. Pass a new amount and/or tenure when the customer wants to change them."
            label: "Get or Update Offer"
            target: "apex://LoanSevaOfferAction"
            include_in_progress_indicator: False
            inputs:
                journeyId: string
                    label: "Journey Id"
                    description: "Loan journey id from the previous action."
                    is_required: False
