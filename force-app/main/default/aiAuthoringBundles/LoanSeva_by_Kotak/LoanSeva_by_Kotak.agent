                    description: "Current messaging session id."
                    is_required: False
                amount: string
                    label: "Amount"
                    description: "New amount as typed, e.g. 3 lakh. Empty to keep the current amount."
                    is_required: False
                tenure: string
                    label: "Tenure"
                    description: "New tenure as typed, e.g. 48 months or 4 years. Empty to keep the current tenure."
                    is_required: False
            outputs:
