<apex:page showHeader="false" sidebar="false" standardStylesheets="false" applyHtmlTag="false" applyBodyTag="false" docType="html-5.0" cache="false" controller="BandhuWebController">
<html lang="en">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
<title>Bandhu | Bandhan Bank Credit Cards</title>
<style>
@font-face{font-family:"Poppins";font-weight:400;font-display:swap;src:url("{!URLFOR($Resource.BandhuFonts,'Poppins-Regular.ttf')}") format("truetype")}
@font-face{font-family:"Poppins";font-weight:500;font-display:swap;src:url("{!URLFOR($Resource.BandhuFonts,'Poppins-Medium.ttf')}") format("truetype")}
@font-face{font-family:"Poppins";font-weight:600;font-display:swap;src:url("{!URLFOR($Resource.BandhuFonts,'Poppins-SemiBold.ttf')}") format("truetype")}
@font-face{font-family:"Poppins";font-weight:700;font-display:swap;src:url("{!URLFOR($Resource.BandhuFonts,'Poppins-Bold.ttf')}") format("truetype")}
:root{
 /* official Bandhan Bank palette: Indigo #0A3152, Ocean Red #A71E1F, Lava Red #EF3B23 */
 --navy:#0A3152;--navy-d:#08263F;--navy-dd:#061A2C;--ink:#0F2540;--blue:#3399E8;
 --red:#A71E1F;--orange:#EF3B23;--sun:linear-gradient(135deg,#A71E1F 0%,#EF3B23 100%);
 --muted:#5A6B80;--line:#E3E8EF;--bg:#F4F6F9;--r:18px;--sh:0 10px 30px rgba(10,49,82,.08);--sh2:0 18px 40px rgba(10,49,82,.16)
}
*{box-sizing:border-box}
html,body{margin:0;padding:0;overflow-x:hidden}
body{font-family:"Poppins","Noto Sans Bengali","Noto Sans Devanagari",-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif;color:var(--ink);background:var(--bg);line-height:1.55;font-size:15px;-webkit-font-smoothing:antialiased}
button{font:inherit;cursor:pointer}
button:focus-visible,a:focus-visible,input:focus-visible{outline:3px solid var(--orange);outline-offset:2px}
a{color:var(--navy)}
.wrap{max-width:1300px;margin:0 auto;padding:0 28px}
.wrap>*,.grid>*{min-width:0}
/* header */
.top{background:#fff;box-shadow:0 1px 0 var(--line);position:sticky;top:0;z-index:20}
.top .wrap{display:flex;align-items:center;gap:32px;height:72px}
.top img{height:40px;width:auto;display:block}
.nav{display:flex;gap:2px;flex:1}
.nav button{background:none;border:0;padding:24px 14px 21px;color:var(--muted);font-weight:500;font-size:15px;border-bottom:3px solid transparent}
.nav button:hover{color:var(--navy)}
.nav button.on{color:var(--navy);font-weight:600;border-bottom-color:var(--orange)}
.signin{background:#fff;color:var(--navy);border:1.5px solid var(--navy);border-radius:999px;padding:8px 22px;font-weight:600;font-size:14px}
.signin:hover{background:var(--navy);color:#fff}
/* hero */
.hero{background:radial-gradient(ellipse at 90% -10%,rgba(239,59,35,.32),transparent 45%),radial-gradient(ellipse at 0% 110%,rgba(239,59,35,.16),transparent 45%),linear-gradient(120deg,var(--navy-dd) 0%,var(--navy-d) 45%,var(--navy) 100%);color:#fff;padding:64px 0 72px;position:relative;overflow:hidden}
.hero .wrap{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,.9fr);gap:48px;align-items:center}
.pill{display:inline-flex;align-items:center;gap:8px;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.22);border-radius:999px;padding:6px 14px 6px 8px;font-size:13px;font-weight:500;color:#D9E3EC}
.pill i{width:22px;height:22px;border-radius:50%;background:var(--sun);display:inline-block}
h1{font-size:50px;line-height:1.12;margin:20px 0 18px;font-weight:700;letter-spacing:-.8px}
h1 em{font-style:normal;background:linear-gradient(90deg,#FF6A4D,#EF3B23);-webkit-background-clip:text;background-clip:text;color:transparent}
.sub{font-size:17px;max-width:540px;color:#C5D3E0;margin:0 0 26px;font-weight:400}
.ctas{display:flex;flex-wrap:wrap;gap:14px;margin-bottom:34px}
.btn{border-radius:999px;padding:14px 30px;font-weight:600;font-size:16px;border:2px solid transparent;transition:transform .15s,box-shadow .15s}
.btn.primary{background:var(--sun);color:#fff;box-shadow:0 10px 24px rgba(167,30,31,.35)}
.btn.primary:hover{transform:translateY(-1px);box-shadow:0 14px 28px rgba(167,30,31,.45)}
.btn.ghost{background:transparent;color:#fff;border-color:rgba(255,255,255,.45)}
.btn.ghost:hover{background:rgba(255,255,255,.08)}
.facts{display:flex;flex-wrap:wrap;gap:28px;margin:0;padding:0;list-style:none}
.facts li b{display:block;font-size:24px;font-weight:700;color:#fff;line-height:1.1}
.facts li span{font-size:13px;color:#A7BBCD}
/* hero visual: a fan of card faces and Bandhu's bubble */
.visual{position:relative;height:380px;max-width:560px;margin-left:auto;width:100%}
.fan{position:absolute;inset:0}
.fan .art{position:absolute;width:300px;box-shadow:0 24px 50px rgba(0,0,0,.35)}
.fan .a1{left:0;top:96px;transform:rotate(-10deg)}
.fan .a2{left:120px;top:48px;transform:rotate(-2deg)}
.fan .a3{left:240px;top:0;transform:rotate(6deg)}
.bubble{position:absolute;right:0;bottom:-10px;background:#fff;color:var(--ink);border-radius:18px 18px 18px 4px;padding:14px 16px 14px 14px;display:flex;gap:12px;align-items:center;max-width:330px;box-shadow:var(--sh2)}
.bubble svg{width:52px;height:52px;flex:none}
.bubble b{display:block;font-size:15px}
.bubble span{font-size:13px;color:var(--muted)}
/* card face */
.art{border-radius:14px;aspect-ratio:1.586;padding:16px 18px;color:#fff;display:flex;flex-direction:column;justify-content:space-between;position:relative;overflow:hidden}
.art:before{content:"";position:absolute;right:-25%;top:-55%;width:85%;height:150%;border-radius:50%;background:rgba(255,255,255,.10)}
.art:after{content:"";position:absolute;left:-30%;bottom:-70%;width:90%;height:120%;border-radius:50%;background:rgba(0,0,0,.10)}
.art>*{position:relative;z-index:1}
.art .row{display:flex;justify-content:space-between;align-items:flex-start}
.art img{height:22px;width:auto}
.art .tl{font-size:11px;font-weight:600;letter-spacing:1.5px;text-transform:uppercase;opacity:.9;padding-top:2px}
.art .mid{display:flex;align-items:center;gap:10px}
.art .chip{width:38px;height:28px;border-radius:6px;background:linear-gradient(135deg,#F9DFA0,#C9963B);box-shadow:inset 0 0 0 1px rgba(0,0,0,.12)}
.art .nfc{width:20px;height:20px;opacity:.85}
.art .nm{font-weight:600;font-size:19px;letter-spacing:.3px}
.art .nm small{display:block;font-size:10px;letter-spacing:2px;opacity:.75;font-weight:500}
/* sections */
.trust{background:#fff;border-bottom:1px solid var(--line)}
.trust ul{display:flex;flex-wrap:wrap;justify-content:space-between;gap:12px 24px;margin:0;padding:18px 0;list-style:none}
.trust li{display:flex;align-items:center;gap:10px;font-size:14px;font-weight:500;color:var(--navy)}
.trust li i{width:34px;height:34px;border-radius:10px;background:#E7EDF3;display:grid;place-items:center;font-style:normal;font-size:17px}
.how{padding:56px 0 8px}
.kicker{color:var(--orange);font-weight:600;font-size:13px;letter-spacing:1.5px;text-transform:uppercase;margin:0 0 6px}
.h2{font-size:30px;font-weight:700;margin:0 0 24px;color:var(--ink);letter-spacing:-.3px}
.steps{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}
.step{background:#fff;border-radius:var(--r);padding:22px;box-shadow:var(--sh);display:flex;gap:16px;align-items:flex-start}
.step .n{flex:none;width:40px;height:40px;border-radius:12px;background:var(--sun);color:#fff;font-weight:700;display:grid;place-items:center}
.step b{display:block;font-size:16px;margin-bottom:2px}
.step span{color:var(--muted);font-size:14px}
.range{padding:48px 0 40px}
.grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:22px;align-items:stretch}
.tile{background:#fff;border-radius:var(--r);box-shadow:var(--sh);padding:14px 14px 18px;position:relative;display:flex;flex-direction:column;gap:8px;border:2px solid transparent;transition:transform .15s,box-shadow .15s}
.tile:hover{transform:translateY(-3px);box-shadow:var(--sh2)}
.tile.pick{border-color:var(--orange);box-shadow:0 16px 36px rgba(239,59,35,.22)}
.tile.off{filter:grayscale(.85);opacity:.6}
.tile .art{margin-bottom:6px}
.tile .art .tl{font-size:9.5px;letter-spacing:1.2px}
.tile .art img{height:20px}
.tile .hd{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-top:2px}
.tile h3{margin:0;font-size:18px;font-weight:600}
.badge{font-size:11px;font-weight:600;letter-spacing:.5px;padding:2px 9px;border-radius:999px;background:#E7EDF3;color:var(--navy)}
.tile .tag{color:var(--muted);font-size:13.5px;margin:0;min-height:42px}
.tile dl{margin:4px 0 0;font-size:13px;display:grid;grid-template-columns:64px 1fr;gap:6px 10px;flex:1;align-content:start}
.tile dt{color:var(--muted)}
.tile dd{margin:0;color:var(--ink)}
.fee{font-weight:600}
.limit{background:#FDECE9;color:#A71E1F;border-radius:10px;padding:8px 12px;font-weight:600;font-size:13.5px}
.ribbon,.noel{position:absolute;top:-11px;left:16px;color:#fff;font-size:12px;font-weight:600;padding:4px 12px;border-radius:999px;z-index:2}
.ribbon{background:var(--sun);box-shadow:0 4px 12px rgba(239,59,35,.4)}
.noel{background:#7A8899}
.skel{height:420px;background:linear-gradient(90deg,#E8ECF1,#F4F6F9,#E8ECF1);border-radius:var(--r)}
.secured{margin-top:26px;background:#fff;border-radius:var(--r);box-shadow:var(--sh);display:grid;grid-template-columns:260px minmax(0,1fr) auto;gap:24px;align-items:center;padding:18px 22px;border-left:5px solid var(--orange)}
.secured[hidden]{display:none}
.secured h3{margin:0 0 4px;font-size:18px}
.secured p{margin:0;color:var(--muted);font-size:14px}
.secured .art{width:260px}
.secured button{border:1.5px solid var(--navy);background:#fff;color:var(--navy);border-radius:999px;padding:10px 20px;font-weight:600;white-space:nowrap}
.secured button:hover{background:var(--navy);color:#fff}
.foot{background:var(--navy-dd);color:#9DB0C2;margin-top:48px}
.foot .wrap{display:flex;align-items:center;gap:24px;padding:26px 24px;flex-wrap:wrap}
.foot img{height:34px}
.foot p{margin:0;font-size:12.5px;flex:1;min-width:240px}
/* chat */
.scrim{position:fixed;inset:0;background:rgba(6,26,44,.5);z-index:40;display:none;backdrop-filter:blur(2px)}
.chat{position:fixed;top:0;right:0;bottom:0;width:460px;max-width:100%;background:#fff;z-index:50;display:none;flex-direction:column;box-shadow:-16px 0 48px rgba(6,26,44,.25)}
.open .scrim{display:block}
.open .chat{display:flex}
.ch-head{background:linear-gradient(120deg,var(--navy-dd),var(--navy));color:#fff;padding:14px 16px;display:flex;align-items:center;gap:12px;border-bottom:3px solid var(--orange)}
.ch-head svg{width:44px;height:44px;background:#fff;border-radius:50%;padding:2px;flex:none}
.ch-head .t{flex:1}
.ch-head b{display:block;font-size:16px;font-weight:600}
.ch-head small{color:#A7BBCD;font-size:12.5px}
.ch-head small:before{content:"";display:inline-block;width:7px;height:7px;border-radius:50%;background:#3DDC84;margin-right:6px;vertical-align:1px}
.x{background:rgba(255,255,255,.14);border:0;color:#fff;width:36px;height:36px;border-radius:50%;font-size:20px}
.langs{display:flex;align-items:center;gap:6px;padding:9px 16px;border-bottom:1px solid var(--line);font-size:13px;color:var(--muted);flex-wrap:wrap}
.langs button{border:1px solid var(--line);background:#fff;border-radius:999px;padding:3px 13px;color:var(--navy);font-weight:500;font-size:13px}
.langs button[aria-pressed="true"]{background:var(--navy);border-color:var(--navy);color:#fff}
.msgs>*{flex-shrink:0}
.msgs{flex:1;overflow-y:auto;padding:18px 16px;background:#F2F5F9;display:flex;flex-direction:column;gap:10px}
.b{max-width:86%;padding:10px 14px;border-radius:16px;font-size:14.5px;word-wrap:break-word;overflow-wrap:anywhere;line-height:1.5}
.b.bot{background:#fff;align-self:flex-start;border-top-left-radius:4px;box-shadow:0 1px 2px rgba(6,26,44,.08)}
.b.me{background:var(--navy);color:#fff;align-self:flex-end;border-top-right-radius:4px}
.b.err{background:#FDECEC;color:#8A1116;align-self:flex-start;border:1px solid #F5B5B7}
.b code{background:#EEF2F7;padding:1px 6px;border-radius:4px;font-size:13px}
.b .q{border-left:3px solid var(--orange);background:#FDF0EE;padding:6px 10px;margin:4px 0;border-radius:6px;display:block}
.b a{word-break:break-all;color:var(--navy);font-weight:500}
.note{align-self:center;background:#E7F5EC;color:#1E6B34;font-size:13px;font-weight:500;padding:6px 14px;border-radius:999px}
.typing{align-self:flex-start;background:#fff;border-radius:14px;padding:12px 14px;display:flex;gap:4px;box-shadow:0 1px 2px rgba(6,26,44,.08)}
.typing i{width:7px;height:7px;border-radius:50%;background:#A9B6C6;animation:bl 1.2s infinite}
.typing i:nth-child(2){animation-delay:.2s}.typing i:nth-child(3){animation-delay:.4s}
@keyframes bl{0%,80%,100%{opacity:.3;transform:translateY(0)}40%{opacity:1;transform:translateY(-3px)}}
.cscroll{display:flex;gap:12px;overflow-x:auto;padding:14px 2px 8px;align-self:stretch;scroll-snap-type:x mandatory}
.cscroll .tile{min-width:236px;max-width:236px;scroll-snap-align:start;box-shadow:0 2px 10px rgba(10,49,82,.1)}
.cscroll .tile .tag{min-height:0}
.opts{display:flex;flex-wrap:wrap;gap:8px;padding:12px 16px 2px;background:#fff;border-top:1px solid var(--line)}
.opts:empty{display:none}
.opts button{border:1.5px solid var(--navy);color:var(--navy);background:#fff;border-radius:999px;padding:7px 15px;font-weight:500;font-size:13.5px;text-align:left}
.opts button:hover{background:#E7EDF3}
.opts button[aria-pressed="true"]{background:var(--navy);color:#fff}
.opts button.go{background:var(--sun);border-color:transparent;color:#fff}
.opts button:disabled{opacity:.5;cursor:default}
.inbar{display:flex;gap:8px;padding:10px 16px calc(12px + env(safe-area-inset-bottom));background:#fff}
.inbar input{flex:1;border:1.5px solid var(--line);border-radius:999px;padding:11px 18px;font:inherit;font-size:14.5px;min-width:0;background:#F8FAFC}
.inbar input:focus-visible{outline:none;border-color:var(--navy);box-shadow:0 0 0 3px rgba(10,49,82,.15);background:#fff}
.inbar button{background:var(--sun);color:#fff;border:0;border-radius:999px;padding:0 22px;font-weight:600}
.inbar button:disabled,.inbar input:disabled{opacity:.55}
/* consent */
.consent{position:fixed;left:50%;transform:translateX(-50%);bottom:16px;width:min(1100px,calc(100% - 24px));background:#fff;border-radius:16px;box-shadow:0 12px 40px rgba(6,26,44,.2);padding:16px 20px;z-index:30;display:flex;gap:20px;align-items:center}
.consent h2{margin:0 0 2px;font-size:15px;font-weight:600}
.consent p{margin:0;color:var(--muted);font-size:13px}
.consent .acts{display:flex;gap:8px}
.consent .acts button{border-radius:999px;padding:9px 18px;font-weight:600;font-size:14px;border:1.5px solid var(--navy);white-space:nowrap}
.acc{background:var(--navy);color:#fff}
.rej{background:#fff;color:var(--navy)}
.consent[hidden]{display:none}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
@media (max-width:1100px){.hero .wrap{grid-template-columns:1fr}.visual{height:300px;max-width:560px}h1{font-size:42px}}
@media (max-width:1100px){.grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media (max-width:860px){.steps{grid-template-columns:1fr}.secured{grid-template-columns:1fr}.secured .art{width:100%;max-width:300px}}
@media (max-width:767px){
 body{font-size:14.5px}
 .wrap{padding:0 16px}
 .nav{display:none}
 .top .wrap{justify-content:space-between;height:62px}
 .top img{height:32px}
 .hero{padding:32px 0 40px}
 .hero .wrap{gap:24px}
 h1{font-size:32px;letter-spacing:-.4px}
 .sub{font-size:15px}
 .ctas .btn{width:100%;text-align:center}
 .facts{display:grid;grid-template-columns:1fr 1fr;gap:14px 20px}
 .facts li b{font-size:20px}
 .visual{height:230px}
 .fan .art{width:210px}
 .fan .a1{left:0;top:56px}.fan .a2{left:22%;top:28px}.fan .a3{left:44%;top:0}
 .bubble{max-width:92%;right:0;bottom:-6px;padding:10px 12px}
 .bubble svg{width:40px;height:40px}
 .trust ul{justify-content:flex-start}
 .trust li{width:calc(50% - 12px);font-size:13px}
 .h2{font-size:24px}
 .grid{grid-template-columns:minmax(0,1fr)}
 .chat{width:100%;box-shadow:none}
 .consent{flex-direction:column;align-items:stretch;bottom:8px;padding:14px 16px;gap:12px}
 .consent .acts button{flex:1}
}
</style>
</head>
<body>
<header class="top">
  <div class="wrap">
    <img src="{!URLFOR($Resource.BandhanLogo)}" alt="Bandhan Bank"/>
    <nav class="nav" aria-label="Main">
      <button type="button" class="on" aria-current="page">Credit Cards</button>
      <button type="button">Accounts</button>
      <button type="button">Deposits</button>
      <button type="button">Loans</button>
      <button type="button">Help</button>
    </nav>
    <button type="button" class="signin">Login</button>
  </div>
</header>

<main>
<section class="hero">
  <div class="wrap">
    <div>
      <span class="pill"><i></i>Meet Bandhu, your AI card advisor</span>
      <h1>The right credit card,<br/>picked for <em>how you spend</em>.</h1>
      <p class="sub">Tell Bandhu what you spend on. Connect your bank accounts for instant approval, no documents needed, and get a virtual card in minutes. In English, &#2361;&#2367;&#2306;&#2342;&#2368; or &#2476;&#2494;&#2434;&#2482;&#2494;.</p>
      <div class="ctas">
        <button type="button" class="btn primary" id="talk">Find my card &#8594;</button>
        <button type="button" class="btn ghost" id="browse">Explore the cards</button>
      </div>
      <ul class="facts">
        <li><b id="nCards">4</b><span>cards to choose from</span></li>
        <li><b>5 min</b><span>to apply, paperless</span></li>
        <li><b>Instant</b><span>virtual card</span></li>
        <li><b>24/7</b><span>on web and WhatsApp</span></li>
      </ul>
    </div>
    <div class="visual" aria-hidden="true">
      <div class="fan"><div class="art a1" style="background:linear-gradient(135deg,#E35A1C,#9B2A0C)" aria-hidden="true"><div class="row"><img src="{!URLFOR($Resource.BandhanLogoWhite)}" alt=""/><span class="tl">Silver</span></div><div class="mid"><span class="chip"></span><svg class="nfc" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round"><path d="M8.5 7a7 7 0 0 1 0 10M12 4.5a11 11 0 0 1 0 15M5 9.5a3.5 3.5 0 0 1 0 5"/></svg></div><span class="nm"><small>CREDIT CARD</small>Ignite</span></div><div class="art a2" style="background:linear-gradient(135deg,#7C3AED,#3B1A8A)" aria-hidden="true"><div class="row"><img src="{!URLFOR($Resource.BandhanLogoWhite)}" alt=""/><span class="tl">Gold</span></div><div class="mid"><span class="chip"></span><svg class="nfc" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round"><path d="M8.5 7a7 7 0 0 1 0 10M12 4.5a11 11 0 0 1 0 15M5 9.5a3.5 3.5 0 0 1 0 5"/></svg></div><span class="nm"><small>CREDIT CARD</small>Flare</span></div><div class="art a3" style="background:linear-gradient(135deg,#1F3B63,#0A1A30)" aria-hidden="true"><div class="row"><img src="{!URLFOR($Resource.BandhanLogoWhite)}" alt=""/><span class="tl">Platinum</span></div><div class="mid"><span class="chip"></span><svg class="nfc" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round"><path d="M8.5 7a7 7 0 0 1 0 10M12 4.5a11 11 0 0 1 0 15M5 9.5a3.5 3.5 0 0 1 0 5"/></svg></div><span class="nm"><small>CREDIT CARD</small>Lumina</span></div></div>
      <div class="bubble"><svg viewBox="0 0 160 160" role="img" aria-label="Bandhu, the Bandhan Bank card advisor"><circle cx="80" cy="80" r="78" fill="#E7EDF3"/><line x1="80" y1="22" x2="80" y2="38" stroke="#0A3152" stroke-width="4" stroke-linecap="round"/><circle cx="80" cy="18" r="7" fill="#EF3B23"/><ellipse cx="80" cy="96" rx="46" ry="48" fill="#fff" stroke="#D3DEE8" stroke-width="2"/><rect x="46" y="54" width="68" height="46" rx="23" fill="#0A3152"/><circle cx="66" cy="76" r="9" fill="#fff"/><circle cx="94" cy="76" r="9" fill="#fff"/><circle cx="68" cy="78" r="4.5" fill="#08263F"/><circle cx="96" cy="78" r="4.5" fill="#08263F"/><path d="M70 90q10 8 20 0" stroke="#fff" stroke-width="3" fill="none" stroke-linecap="round"/><path d="M46 120q34 18 68 0v7q-34 16-68 0z" fill="#A71E1F"/></svg><div><b>Hi, I'm Bandhu &#128075;</b><span>Tell me how you spend and I'll find the card that pays you back the most.</span></div></div>
    </div>
  </div>
</section>

<section class="trust" aria-label="Why apply with Bandhu">
  <div class="wrap"><ul>
    <li><i>&#127974;</i>RBI-regulated Account Aggregator</li>
    <li><i>&#128274;</i>DPDP Act 2023 consent</li>
    <li><i>&#128203;</i>No documents, no branch visit</li>
    <li><i>&#128172;</i>English, Hindi &amp; Bengali</li>
  </ul></div>
</section>

<section class="how" aria-labelledby="howTitle">
  <div class="wrap">
    <p class="kicker">How it works</p>
    <h2 class="h2" id="howTitle">Your card in three steps</h2>
    <div class="steps">
      <div class="step"><span class="n">1</span><div><b>Tell us how you spend</b><span>Travel, dining, groceries, fuel: Bandhu matches the card to your life.</span></div></div>
      <div class="step"><span class="n">2</span><div><b>Connect your accounts</b><span>Consent once through Account Aggregator: your income is verified in seconds.</span></div></div>
      <div class="step"><span class="n">3</span><div><b>Get your virtual card</b><span>Aadhaar eKYC and a quick video KYC, then start using your card online.</span></div></div>
    </div>
  </div>
</section>

<section class="range" id="range" aria-labelledby="rangeTitle">
  <div class="wrap">
    <p class="kicker">The card range</p>
    <h2 class="h2" id="rangeTitle">Pick a card, or let Bandhu recommend one</h2>
    <div class="grid" id="grid"><div class="skel"></div><div class="skel"></div><div class="skel"></div><div class="skel"></div></div>
    <div class="secured" id="secured" hidden="hidden"></div>
  </div>
</section>
</main>

<footer class="foot">
  <div class="wrap">
    <img src="{!URLFOR($Resource.BandhanLogoWhite)}" alt="Bandhan Bank"/>
    <p>Demo experience. Card features, fees and limits are indicative and subject to Bandhan Bank policy and approval. Account Aggregator, credit bureau and KYC checks are simulated in this demo.</p>
  </div>
</footer>


<div class="scrim" id="scrim"></div>
<section class="chat" id="chat" role="dialog" aria-modal="true" aria-labelledby="chatTitle">
  <div class="ch-head">
    <svg viewBox="0 0 160 160" aria-hidden="true"><circle cx="80" cy="80" r="78" fill="#E7EDF3"/><line x1="80" y1="22" x2="80" y2="38" stroke="#0A3152" stroke-width="4" stroke-linecap="round"/><circle cx="80" cy="18" r="7" fill="#EF3B23"/><ellipse cx="80" cy="96" rx="46" ry="48" fill="#fff" stroke="#D3DEE8" stroke-width="2"/><rect x="46" y="54" width="68" height="46" rx="23" fill="#0A3152"/><circle cx="66" cy="76" r="9" fill="#fff"/><circle cx="94" cy="76" r="9" fill="#fff"/><circle cx="68" cy="78" r="4.5" fill="#08263F"/><circle cx="96" cy="78" r="4.5" fill="#08263F"/><path d="M70 90q10 8 20 0" stroke="#fff" stroke-width="3" fill="none" stroke-linecap="round"/><path d="M46 120q34 18 68 0v7q-34 16-68 0z" fill="#A71E1F"/></svg>
    <div class="t"><b id="chatTitle">Bandhu</b><small>Bandhan Bank card advisor · online</small></div>
    <button type="button" class="x" id="close" aria-label="Close chat">&#215;</button>
  </div>
  <div class="langs" role="group" aria-label="Chat language">
    <span>I'd like to chat in:</span>
    <button type="button" data-lang="EN" aria-pressed="true">English</button>
    <button type="button" data-lang="HI" aria-pressed="false" lang="hi">&#2361;&#2367;&#2306;&#2342;&#2368;</button>
    <button type="button" data-lang="BN" aria-pressed="false" lang="bn">&#2476;&#2494;&#2434;&#2482;&#2494;</button>
  </div>
  <div class="msgs" id="msgs" aria-live="polite" aria-relevant="additions"></div>
  <div class="opts" id="opts"></div>
  <form class="inbar" id="form" autocomplete="off">
    <label for="inp" class="sr">Type your message</label>
    <input id="inp" type="text" maxlength="500" placeholder="Type a message..."/>
    <button type="submit" id="sendBtn">Send</button>
  </form>
</section>

<aside class="consent" id="consent" aria-labelledby="ckTitle" hidden="hidden">
  <div style="flex:1">
    <h2 id="ckTitle">&#127850; Cookie preferences &amp; privacy notice</h2>
    <p>We use cookies and similar technologies to run this site and improve your experience. Your chat data is processed under the DPDP Act, 2023 only to recommend and process your card application. You can change your choice anytime in the Privacy Centre.</p>
  </div>
  <div class="acts">
    <button type="button" class="acc" id="ckAcc">Accept all</button>
    <button type="button" class="rej" id="ckRej">Reject all</button>
  </div>
</aside>

<script>
var BW = {
  start: '{!$RemoteAction.BandhuWebController.start}',
  send: '{!$RemoteAction.BandhuWebController.send}',
  language: '{!$RemoteAction.BandhuWebController.language}'
};
</script>
<script>
//<![CDATA[
(function () {
  'use strict';
  var IN_CHAT_STEPS = { choose: 1, not_eligible: 1, after_compare: 1, secured_offer: 1, applied_alt: 1 };
  var state = { token: null, busy: false, first: null, shown: false, lang: 'EN', picks: {} };
  var $ = function (id) { return document.getElementById(id); };
  var msgs = $('msgs'), opts = $('opts'), inp = $('inp'), sendBtn = $('sendBtn');

  function esc(s) {
    return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  }

  /* WhatsApp-style markdown on already-escaped text */
  function md(text) {
    var keep = [];
    var hold = function (html) { keep.push(html); return '\u0000' + (keep.length - 1) + '\u0000'; };
    var s = esc(text);
    s = s.replace(/```([\s\S]+?)```/g, function (m, c) { return hold('<code>' + c + '</code>'); });
    s = s.replace(/https?:\/\/[^\s<]+[^\s<.,;:!?)\]]/g, function (u) {
      return hold('<a href="' + u + '" target="_blank" rel="noopener noreferrer">' + u + '</a>');
    });
    s = s.replace(/(^|[\s(])\*(\S[^*\n]*?)\*(?=$|[\s.,;:!?)])/g, '$1<b>$2</b>');
    s = s.replace(/(^|[\s(])_(\S[^_\n]*?)_(?=$|[\s.,;:!?)])/g, '$1<i>$2</i>');
    var lines = s.split(/\r?\n/), out = [];
    for (var i = 0; i < lines.length; i++) {
      var ln = lines[i];
      if (ln.indexOf('&gt; ') === 0) { out.push('<span class="q">' + ln.substring(5) + '</span>'); }
      else { out.push(ln + (i < lines.length - 1 && !(lines[i + 1].indexOf('&gt; ') === 0) ? '<br>' : '')); }
    }
    s = out.join('');
    return s.replace(/\u0000(\d+)\u0000/g, function (m, n) { return keep[+n]; });
  }

  function rupee(n) {
    if (n == null) { return ''; }
    return '₹' + Number(n).toLocaleString('en-IN');
  }

  function shade(hex, amt) {
    var h = /^#?([0-9a-f]{6})$/i.exec(hex || '');
    if (!h) { return '#7A0E14'; }
    var v = parseInt(h[1], 16), r = (v >> 16) + amt, g = ((v >> 8) & 255) + amt, b = (v & 255) + amt;
    var c = function (x) { return Math.max(0, Math.min(255, x)); };
    return '#' + ((1 << 24) + (c(r) << 16) + (c(g) << 8) + c(b)).toString(16).slice(1);
  }

  var LOGO_W = '{!URLFOR($Resource.BandhanLogoWhite)}';
  var NFC = '<svg class="nfc" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round"><path d="M8.5 7a7 7 0 0 1 0 10M12 4.5a11 11 0 0 1 0 15M5 9.5a3.5 3.5 0 0 1 0 5"/></svg>';

  function cardArt(c) {
    var col = /^#[0-9a-f]{6}$/i.test(c.color || '') ? c.color : '#0A3152';
    return '<div class="art" style="background:linear-gradient(135deg,' + col + ',' + shade(col, -70) + ')" role="img" aria-label="' + esc(c.name) + ' card design">'
      + '<div class="row"><img src="' + LOGO_W + '" alt=""/><span class="tl">' + esc(c.tierLabel || '') + '</span></div>'
      + '<div class="mid"><span class="chip"></span>' + NFC + '</div>'
      + '<span class="nm"><small>' + (c.secured ? 'SECURED CREDIT CARD' : 'CREDIT CARD') + '</small>' + esc(c.name) + '</span></div>';
  }

  function tile(c) {
    var cls = 'tile' + (c.recommended ? ' pick' : '') + (c.eligible === false ? ' off' : '');
    var h = '<article class="' + cls + '">';
    if (c.recommended) { h += '<span class="ribbon">&#9733; Bandhu\'s pick for you</span>'; }
    else if (c.eligible === false) { h += '<span class="noel">Not eligible yet</span>'; }
    h += cardArt(c);
    h += '<div class="hd"><h3>' + esc(c.name) + '</h3>' + (c.tierLabel ? '<span class="badge">' + esc(c.tierLabel) + '</span>' : '') + '</div>';
    h += '<p class="tag">' + esc(c.tagline) + '</p><dl>';
    h += '<dt>Fee</dt><dd class="fee">' + (c.joiningFee ? 'Joining ' + rupee(c.joiningFee) : 'Lifetime free') + '</dd>';
    if (c.rewards) { h += '<dt>Rewards</dt><dd>' + esc(c.rewards) + '</dd>'; }
    if (c.lounge) { h += '<dt>Lounge</dt><dd>' + esc(c.lounge) + '</dd>'; }
    if (c.welcome) { h += '<dt>Welcome</dt><dd>' + esc(c.welcome) + '</dd>'; }
    h += '</dl>';
    if (c.creditLimit) { h += '<div class="limit">Indicative limit ' + esc(String(c.creditLimit).replace(/^₹\s*/, '₹')) + '</div>'; }
    return h + '</article>';
  }

  /* entry to premium; the FD-secured card is shown apart, as the way in for anyone */
  function ordered(cards) {
    return cards.slice().sort(function (a, b) { return (a.secured ? 1 : 0) - (b.secured ? 1 : 0) || (a.tier || 0) - (b.tier || 0); });
  }

  function renderGrid(cards) {
    if (!cards || !cards.length) { $('grid').innerHTML = '<p>Talk to Bandhu to see the card range.</p>'; return; }
    var main = ordered(cards).filter(function (c) { return !c.secured; });
    var sec = cards.filter(function (c) { return c.secured; })[0];
    $('grid').innerHTML = main.map(tile).join('');
    $('nCards').textContent = cards.length;
    if (sec) {
      $('secured').innerHTML = cardArt(sec) + '<div><p class="kicker" style="margin:0 0 2px">Building your credit?</p><h3>Bandhan ' + esc(sec.name) + ': ' + esc(sec.tagline) + '</h3>'
        + '<p>' + (sec.joiningFee ? 'Joining ' + rupee(sec.joiningFee) : 'Lifetime free') + ' · limit 90% of your FD, which keeps earning interest · no income proof or credit history needed'
        + (sec.recommended && sec.creditLimit ? ' · <b>your limit ' + esc(sec.creditLimit) + '</b>' : '') + '</p></div>'
        + '<button type="button" id="secBtn">Ask Bandhu</button>';
      $('secured').hidden = false;
      $('secBtn').onclick = openChat;
    }
  }

  function scrollDown() { msgs.scrollTop = msgs.scrollHeight; }

  function addBubble(kind, html) {
    var d = document.createElement('div');
    d.className = 'b ' + kind;
    d.innerHTML = html;
    msgs.appendChild(d);
    scrollDown();
    return d;
  }

  function setBusy(b) {
    state.busy = b;
    inp.disabled = b; sendBtn.disabled = b;
    var bs = opts.querySelectorAll('button');
    for (var i = 0; i < bs.length; i++) { bs[i].disabled = b; }
    var t = $('typing');
    if (b && !t) {
      t = document.createElement('div'); t.id = 'typing'; t.className = 'typing';
      t.setAttribute('aria-label', 'Bandhu is typing'); t.innerHTML = '<i></i><i></i><i></i>';
      msgs.appendChild(t); scrollDown();
    } else if (!b && t) { t.parentNode.removeChild(t); }
  }

  function renderOptions(turn) {
    opts.innerHTML = '';
    state.picks = {};
    var list = turn.options || [];
    if (!list.length) { return; }
    var multi = turn.step === 'spend';
    opts.setAttribute('aria-label', multi ? 'Pick all that apply' : 'Quick replies');
    list.forEach(function (label, i) {
      var b = document.createElement('button');
      b.type = 'button';
      b.textContent = label;
      if (multi) {
        b.setAttribute('aria-pressed', 'false');
        b.onclick = function () {
          var on = b.getAttribute('aria-pressed') !== 'true';
          b.setAttribute('aria-pressed', on ? 'true' : 'false');
          if (on) { state.picks[i + 1] = label; } else { delete state.picks[i + 1]; }
          go.disabled = !Object.keys(state.picks).length;
        };
      } else {
        b.onclick = function () { send(String(i + 1), label); };
      }
      opts.appendChild(b);
    });
    if (multi) {
      var go = document.createElement('button');
      go.type = 'button'; go.className = 'go'; go.textContent = 'Continue →'; go.disabled = true;
      go.onclick = function () {
        var nums = Object.keys(state.picks).map(Number).sort(function (a, b) { return a - b; });
        if (!nums.length) { return; }
        send(nums.join(', '), nums.map(function (n) { return state.picks[n]; }).join(', '));
      };
      opts.appendChild(go);
    }
  }

  function setLangUi(lang) {
    state.lang = lang || 'EN';
    document.documentElement.lang = { EN: 'en', HI: 'hi', BN: 'bn' }[state.lang] || 'en';
    var bs = document.querySelectorAll('.langs button');
    for (var i = 0; i < bs.length; i++) { bs[i].setAttribute('aria-pressed', bs[i].getAttribute('data-lang') === state.lang ? 'true' : 'false'); }
  }

  function showTurn(turn) {
    state.last = turn;
    if (turn.token) { state.token = turn.token; }
    if (turn.language) { setLangUi(turn.language); }
    if (turn.message) { addBubble('bot', md(turn.message)); }
    if (turn.cards && turn.cards.length && IN_CHAT_STEPS[turn.step]) {
      turn.cards = ordered(turn.cards).sort(function (a, b) { return (b.recommended ? 1 : 0) - (a.recommended ? 1 : 0); });
      var row = document.createElement('div');
      row.className = 'cscroll';
      row.setAttribute('role', 'list');
      row.innerHTML = turn.cards.map(tile).join('');
      msgs.appendChild(row);
      if (turn.step !== 'after_compare') { renderGrid(turn.cards); }
    }
    if (turn.handoff) {
      var n = document.createElement('div'); n.className = 'note';
      n.textContent = '☎ A Bandhan Bank specialist will contact you';
      msgs.appendChild(n);
    }
    renderOptions(turn);
    scrollDown();
  }

  function errBubble(event) {
    var m = event && event.message ? String(event.message) : '';
    var friendly = /session|refresh/i.test(m) ? m : 'Sorry, something went wrong on our side. Please try again in a moment.';
    addBubble('err', esc(friendly));
    if (window.console) { console.warn('Bandhu remoting error', event && event.type); }
  }

  function call(action, args, done) {
    var a = [action].concat(args);
    a.push(function (result, event) {
      if (event.status && result) { done(result); } else { done(null, event); }
    });
    a.push({ escape: false, buffer: false, timeout: 60000 });
    Visualforce.remoting.Manager.invokeAction.apply(Visualforce.remoting.Manager, a);
  }

  var starting = null;
  function startJourney(cb) {
    if (state.token) { cb && cb(true); return; }
    if (starting) { starting.push(cb); return; }
    starting = [cb];
    call(BW.start, [state.lang, 'Web'], function (turn, event) {
      var q = starting; starting = null;
      if (turn) {
        state.token = turn.token; state.first = turn;
        renderGrid(turn.cards);
      } else {
        state.startErr = event;
        if (!$('grid').querySelector('.tile')) { $('grid').innerHTML = '<p>We could not load the card range right now. Talk to Bandhu or refresh to try again.</p>'; }
      }
      q.forEach(function (f) { f && f(!!turn, event); });
    });
  }

  function send(text, display) {
    if (state.busy || !text) { return; }
    addBubble('me', esc(display || text));
    opts.innerHTML = '';
    setBusy(true);
    var go = function () {
      call(BW.send, [state.token, text], function (turn, event) {
        setBusy(false);
        if (turn) { showTurn(turn); } else { errBubble(event); if (state.last) { renderOptions(state.last); } }
        inp.focus();
      });
    };
    if (state.token) { go(); }
    else { startJourney(function (ok, ev) { if (ok) { go(); } else { setBusy(false); errBubble(ev); } }); }
  }

  function openChat() {
    document.body.classList.add('open');
    if (window.matchMedia('(max-width:767px)').matches) { document.body.style.overflow = 'hidden'; }
    inp.focus();
    if (state.shown) { return; }
    setBusy(true);
    startJourney(function (ok, ev) {
      setBusy(false);
      if (ok && state.first) { state.shown = true; showTurn(state.first); }
      else if (!ok) { errBubble(ev); }
    });
  }

  function closeChat() {
    document.body.classList.remove('open');
    document.body.style.overflow = '';
    $('talk').focus();
  }

  function changeLang(lang) {
    if (state.busy || lang === state.lang) { return; }
    if (!state.token) { state.lang = lang; setLangUi(lang); return; }
    setBusy(true);
    call(BW.language, [state.token, lang], function (turn, event) {
      setBusy(false);
      if (turn) { state.shown = true; showTurn(turn); } else { errBubble(event); }
    });
  }

  $('talk').onclick = openChat;
  $('browse').onclick = function () { $('range').scrollIntoView({ behavior: 'smooth' }); };
  $('close').onclick = closeChat;
  $('scrim').onclick = closeChat;
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && document.body.classList.contains('open')) { closeChat(); } });
  $('form').onsubmit = function (e) {
    e.preventDefault();
    var t = inp.value.trim();
    if (!t) { return; }
    inp.value = '';
    send(t);
  };
  var lb = document.querySelectorAll('.langs button');
  for (var i = 0; i < lb.length; i++) {
    lb[i].onclick = (function (b) { return function () { changeLang(b.getAttribute('data-lang')); }; })(lb[i]);
  }

  /* cosmetic consent banner */
  var ck = null;
  try { ck = sessionStorage.getItem('bandhuConsent'); } catch (e) { ck = null; }
  if (!ck) { $('consent').hidden = false; }
  var setCk = function (v) { try { sessionStorage.setItem('bandhuConsent', v); } catch (e) {} $('consent').hidden = true; };
  $('ckAcc').onclick = function () { setCk('all'); };
  $('ckRej').onclick = function () { setCk('none'); };

  startJourney();
})();
//]]>
</script>
</body>
</html>
